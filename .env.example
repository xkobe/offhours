# HoodScope environment template — copy to .env (or set as env vars) and fill in.

# --- 数据层 ---
# RPC: 公共 RPC 可直接使用；生产建议注册 Alchemy/QuickNode 后替换为托管端点
#   Alchemy mainnet:  https://robinhood-mainnet.g.alchemy.com/v2/{API_KEY}
#   Alchemy testnet:  https://robinhood-testnet.g.alchemy.com/v2/{API_KEY}
#   QuickNode:        https://{ENDPOINT}.robinhood-mainnet.quiknode.pro/{TOKEN}
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# SQLite 数据库路径（默认 ./data/hoodscope.db）
HOODSCOPE_DB=./data/hoodscope.db

# 溢价事件检测阈值（%），盘外异常按此阈值分层
PREMIUM_THRESHOLD=2

# --- 链上锚定（阶段 2） ---
# 部署锚定注册表合约的钱包私钥（测试网 46630 用测试钱包，主网 4663 用带 ETH gas 的钱包）
DEPLOYER_PRIVATE_KEY=
# 部署目标链：46630 = 测试网（默认），4663 = 主网
CHAIN_ID=46630
# 部署完成后填写的锚定合约地址
ANCHOR_REGISTRY_ADDRESS=

# --- 可验证报告（IPFS pinning） ---
# web3.storage 兼容上传端点；不配 IPFS_TOKEN 时只计算 CID 不实际上传（dry-run）
IPFS_UPLOAD_URL=https://api.web3.storage/upload
IPFS_TOKEN=

# --- 溢价阈值警报（阶段 4：Telegram Bot） ---
# 在 @BotFather 创建机器人获得 token，chat_id 为接收推送的群/用户 id
# 不配置时警报引擎以 dry-run 模式运行（日志打印将推送内容，不实际发送）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 阈值阶梯（%），默认 1,2,3,5,10,20,50；hysteresis=回落多少比例才解除警报
ALERT_THRESHOLDS=1,2,3,5,10,20,50
ALERT_HYSTERESIS=0.5

# --- 服务端口 ---
PORT=4663
